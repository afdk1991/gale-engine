# ============================================================================
#  项目002 — 疾风引擎 gale-engine（Electron 桌面应用）忽略规则
#
#  ⚠️ 重要：顶层 /build/ 是 electron-builder 的【源资源】目录
#     （build/icon.ico、build/icon.png、build/entitlements.mac.plist），
#     必须入库，因此本文件【不得】出现裸 build/ 规则。
#     需要忽略的是 release/、release-build/、out/ 这些产物目录。
# ============================================================================

# ===== 依赖 =====
node_modules/
**/node_modules/

# ===== 环境与部署凭据（绝不入库）=====
.env
.env.local
.env.*.local
**/.env
.edgeone/
.wrangler/
*.pem
*.key
*.pfx
*.p12
*.keystore

# ===== Electron 打包产物与安装包（曾达 720 MB，严禁入库）=====
release/
release-build/
out/
dist/
dist-electron/
*.asar
*.appx
*.msix
*.msixbundle
*.snap
*.dmg
*.AppImage
*.deb
*.rpm
dev-app-update.yml

# ===== 各子平台的产物目录（不影响顶层 /build/ 源资源）=====
platforms/*/build/
platforms/*/release/
platforms/*/dist/
platforms/*/node_modules/

# ===== 日志、临时脚本与缓存 =====
*.log
.build.log
_t/
.cache/
.tmp/
__pycache__/
*.pyc
.pytest_cache/
coverage/
.verify-shots/

# ===== 系统与编辑器临时文件 =====
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
